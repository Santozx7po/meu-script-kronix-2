-- ===== 3. LÓGICA DO AIMBOT =====
local function GetClosestPlayer()
    local closest = nil
    local shortestDist = State.AimFOV
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum and hum.Health > 0 then
                -- Se o TeamCheck estiver ligado, verifica se é do mesmo time
                if not State.TeamCheck or player.Team ~= LocalPlayer.Team then
                    local root = char.HumanoidRootPart
                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                        if dist < shortestDist then
                            -- WallCheck (Verifica se tem parede)
                            local ray = Ray.new(Camera.CFrame.Position, (root.Position - Camera.CFrame.Position).Unit * 500)
                            local hit = workspace:FindPartOnRay(ray, LocalPlayer.Character)
                            
                            if not State.WallCheck or (hit and hit:IsDescendantOf(char)) then
                                shortestDist = dist
                                closest = char
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if State.AimbotEnabled then
        local target = GetClosestPlayer()
        if target and target:FindFirstChild(State.AimPart) then
            local targetPos = target[State.AimPart].Position
            local currentCFrame = Camera.CFrame
            local newCFrame = CFrame.new(currentCFrame.Position, targetPos)
            
            -- Move a câmera suavemente para o alvo
            Camera.CFrame = currentCFrame:Lerp(newCFrame, State.AimSmoothness)
        end
    end
end)

-- ===== 4. LÓGICA DO AUTO FARM (PESCA) =====
-- (Adaptação genérica para tentar interagir com o sistema de pesca)
local function FarmLoop()
    task.spawn(function()
        while task.wait(1) do
            if State.FarmEnabled then
                local char = LocalPlayer.Character
                if not char then continue end
                
                -- Simula o clique do mouse para pescar
                local VirtualUser = game:GetService("VirtualUser")
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2))
                end)
            end
        end
    end)
end

